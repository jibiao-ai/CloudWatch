# 复制为 .env 并修改
DB_ROOT_PASSWORD=change-me-root
DB_PASSWORD=change-me-db
# 初始 admin 密码；留空则随机生成，首次启动日志输出一次（docker compose logs cloudwatch-backend | grep admin）
CW_ADMIN_PASSWORD=
# 渠道密钥加密主密钥；留空则首次启动自动生成并存入数据库
CW_SECRET_KEY=
WEB_PORT=80
# true 写入演示账号（admin 密码 CloudWatch@2026 等）与演示数据；demo 环境可设 true，正式环境保持 false
CW_SEED_DEMO=false
# 镜像标签，默认 latest
CW_IMAGE_TAG=latest
