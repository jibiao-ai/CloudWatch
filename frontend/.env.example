# 接口基础路径（相对路径，兼容 IP / 域名访问）
VITE_API_BASE=/api
# mock 三态开关：
#   hybrid（默认）认证/系统配置/审计日志走真实后端，其余尚未开发的模块仍用 mock
#   true          全部 mock（纯前端演示，无需后端）
#   false         全部走真实后端
VITE_USE_MOCK=hybrid
# 开发 / preview 代理目标（npm run dev / vite preview）；生产由 nginx 反代 /api
VITE_PROXY_TARGET=http://127.0.0.1:8080
